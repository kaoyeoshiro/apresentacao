#!/usr/bin/env bash
# Atalho do projeto: ./ap <comando> [args]  (ex.: ./ap sondar decks/demo)
# O ambiente Python fica fora do disco externo (exFAT cria arquivos ._ que quebram wheels).
set -euo pipefail
RAIZ="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
export UV_PROJECT_ENVIRONMENT="${UV_PROJECT_ENVIRONMENT:-$HOME/.venvs/apresentacao}"
export UV_LINK_MODE=copy PYTHONUNBUFFERED=1
cd "$RAIZ"
uso="uso: ./ap <novo|abrir|sondar|paradas|pdf|video|empacotar|publicar|imagem|imagens|video-ia|trazer|tratar|midia|render|lint|teste|sync> [args]"
[ $# -eq 0 ] && { echo "$uso"; exit 1; }
cmd="$1"; shift
case "$cmd" in
  sync) exec uv sync ;;
  teste) exec uv run --quiet pytest -q "$@" ;;
  novo|abrir|sondar|paradas|pdf|video|empacotar) exec uv run --quiet python -m ferramentas.palco "$cmd" "$@" ;;
  publicar) exec uv run --quiet python -m ferramentas.publicar "$@" ;;   # ./ap publicar <deck> --site <pasta> --pasta aula-2 ...
  imagem|video-ia|trazer) exec uv run --quiet python -m ferramentas.midia "$cmd" "$@" ;;
  midia) exec uv run --quiet python -m ferramentas.midia "$@" ;;          # ./ap midia conferir <deck>
  imagens) exec uv run --quiet python -m ferramentas.imagens "$@" ;;      # ./ap imagens <deck> [--rascunhos|--final|--tratar]
  tratar) exec uv run --quiet python -m ferramentas.tratar "$@" ;;
  render) exec uv run --quiet python -m ferramentas.render "$@" ;;
  lint) exec uv run --quiet python -m ferramentas.lint "$@" ;;
  *) echo "$uso"; exit 1 ;;
esac
